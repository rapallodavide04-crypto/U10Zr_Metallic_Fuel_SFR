  "trade_off_table": [
    {
      "concept": "U-10Zr (Na) / 316SS-D9",
      "advantages": "High early creep strength; no low-T DBTT; historical EBR-II data",
      "disadvantages": "Severe FCC void swelling after incubation; Ni leaching/FCCI",
      "limiting_factors": "Void swelling (~10 at% BU cap)"
    },
    {
      "concept": "U-10Zr (Na) / HT9 (Baseline)",
      "advantages": "<2% swelling at 200 dpa; 1,262-pin NRC database; high k",
      "disadvantages": "High-burnup FCCI wastage; reactive Na-bond waste",
      "limiting_factors": "Creep >650 C; U-Fe eutectic (725 C)"
    },
    {
      "concept": "U-10Zr (Na + Liner/Pd) / HT9",
      "advantages": "Cuts FCCI wastage & extends burnup using qualified HT9 tube",
      "disadvantages": "Extra fabrication/coating cost; unaddressed HT9 creep ceiling",
      "limiting_factors": "HT9 thermal creep >650 C; liner bonding QA"
    },
    {
      "concept": "Annular U-10Zr (He) / 9Cr-ODS",
      "advantages": "No reactive Na waste; creep to ~700 C; low alpha' risk",
      "disadvantages": "Lower gap k_He; expensive PM/MA tubing; low TRL",
      "limiting_factors": "PRW end-cap weld qual.; tight gap tolerances"
    },
    {
      "concept": "MOX / 15-15Ti (Benchmark)",
      "advantages": "Mature oxide/LWR fabrication & European LFR/SFR heritage",
      "disadvantages": "8-10x lower k; lower fissile density; no Na-bond synergy",
      "limiting_factors": "Centerline T margin; 15-15Ti swelling >120 dpa"
    }
  ]
}
